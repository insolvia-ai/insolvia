{
  "openapi": "3.1.0",
  "info": {
    "title": "Insolvia admin service",
    "version": "1",
    "description": "The staff-only service behind the admin portal (`backend/src/Insolvia.Admin`): provisioning firms and their first users. Generated by `tool/render-openapi.ts` from `tool/openapi/admin-routes.ts` and the admin client's types — do not edit by hand. Errors share the API's envelope."
  },
  "servers": [{ "url": "http://127.0.0.1:8090", "description": "Local (docker compose up)" }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["health"],
        "summary": "Liveness, and which build answered.",
        "security": [],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Health" } }
            }
          },
          "4XX": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/firms": {
      "get": {
        "operationId": "listFirms",
        "tags": ["firms"],
        "summary": "Every firm, with its user count.",
        "security": [{ "google": [] }],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "firms": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/FirmSummary" }
                    }
                  },
                  "required": ["firms"]
                }
              }
            }
          },
          "4XX": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "provisionFirm",
        "tags": ["firms"],
        "summary": "Provision a firm and invite its first admin.",
        "description": "Creates the firm and its first user, an admin with every permission, and sends that person a sign-in invitation. A 409 means a firm or user with that identity already exists.",
        "security": [{ "google": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ProvisionRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "firm": { "$ref": "#/components/schemas/FirmRecord" },
                    "admin": { "$ref": "#/components/schemas/FirmUser" }
                  },
                  "required": ["firm", "admin"]
                }
              }
            }
          },
          "4XX": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/firms/{firmId}": {
      "get": {
        "operationId": "getFirm",
        "tags": ["firms"],
        "summary": "One firm, with its user count.",
        "security": [{ "google": [] }],
        "parameters": [
          { "name": "firmId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/FirmSummary" } }
            }
          },
          "4XX": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "operationId": "setFirmStatus",
        "tags": ["firms"],
        "summary": "Suspend or reactivate a firm.",
        "description": "A suspended firm stays in place, but none of its users can reach the API until it is reactivated.",
        "security": [{ "google": [] }],
        "parameters": [
          { "name": "firmId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "status": { "type": "string", "enum": ["active", "suspended"] } },
                "required": ["status"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/FirmRecord" } }
            }
          },
          "4XX": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/firms/{firmId}/users": {
      "get": {
        "operationId": "listFirmUsers",
        "tags": ["firms users"],
        "summary": "A firm's users.",
        "security": [{ "google": [] }],
        "parameters": [
          { "name": "firmId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "users": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/FirmUser" }
                    }
                  },
                  "required": ["users"]
                }
              }
            }
          },
          "4XX": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/firms/{firmId}/users/{subject}/resend-invite": {
      "post": {
        "operationId": "resendInvite",
        "tags": ["firms users"],
        "summary": "Send a user their sign-in invitation again.",
        "security": [{ "google": [] }],
        "parameters": [
          { "name": "firmId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "subject", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "No content." },
          "4XX": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FirmRecord": {
        "description": "The admin service's firm without its user count: what a write answers.",
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["active", "suspended"] },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" },
          "createdBy": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "createdByEmail": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        },
        "required": [
          "status",
          "id",
          "name",
          "createdAt",
          "updatedAt",
          "createdBy",
          "createdByEmail"
        ]
      },
      "FirmSummary": {
        "description": "A small typed client for the admin service's six routes.\n\nA package rather than in-app because it has two consumers — the portal, and `contract/`, which proves this same code against the real service (ADR 0029 rule 2) — and unpublished, so there is only ever one version. `client.test.ts` asserts method, URL, headers and body against literal JSON copied from the service's route handlers.\n\nThe token arrives through a PROVIDER read per request (the same seam the app's client uses), and a 401 raises `AdminUnauthorizedError` so the caller can route to sign-in — there is no refresh to attempt (#209: memory-only tokens; expiry means re-authenticate).",
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "suspended"] },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" },
          "createdBy": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "createdByEmail": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "userCount": { "type": "number" }
        },
        "required": [
          "id",
          "name",
          "status",
          "createdAt",
          "updatedAt",
          "createdBy",
          "createdByEmail",
          "userCount"
        ]
      },
      "FirmUser": {
        "type": "object",
        "properties": {
          "subject": { "type": "string" },
          "email": { "type": "string" },
          "firstName": {
            "description": "The two halves. Either may be `''` — the server derives them for rows written before the name was two fields, and a name it cannot split yields an empty surname.",
            "type": "string"
          },
          "lastName": { "type": "string" },
          "displayName": {
            "description": "The composed name, for display. Server-derived; nothing writes it.",
            "type": "string"
          },
          "role": { "type": "string" },
          "isAdmin": { "type": "boolean" },
          "accessAllCases": { "type": "boolean" },
          "permissions": { "type": "object", "additionalProperties": { "type": "string" } },
          "status": { "type": "string", "enum": ["active", "disabled"] },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" }
        },
        "required": [
          "subject",
          "email",
          "firstName",
          "lastName",
          "displayName",
          "role",
          "isAdmin",
          "accessAllCases",
          "permissions",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "Health": {
        "description": "`GET /health` — liveness, and which build answered.",
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "service": { "type": "string" },
          "version": { "type": "string" },
          "environment": { "type": "string" }
        },
        "required": ["status", "service", "version", "environment"]
      },
      "ProvisionRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "admin": {
            "type": "object",
            "properties": {
              "email": { "type": "string" },
              "firstName": { "type": "string" },
              "lastName": { "type": "string" }
            },
            "required": ["email", "firstName", "lastName"]
          }
        },
        "required": ["name", "admin"]
      }
    },
    "responses": {
      "Error": {
        "description": "A refusal, in the shared error envelope.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "description": "A stable code: `ValidationError`, `NotFound`, …"
                },
                "message": { "type": "string" },
                "fields": {
                  "type": "object",
                  "additionalProperties": { "type": "string" },
                  "description": "Per-field messages, on a 400 that names fields."
                }
              },
              "required": ["error"]
            }
          }
        }
      }
    },
    "securitySchemes": {
      "google": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "A staff member's Google Workspace ID token."
      }
    }
  }
}
