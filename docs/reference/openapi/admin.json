{
  "openapi": "3.1.1",
  "info": {
    "title": "Insolvia admin service",
    "description": "The staff portal\u0027s service: provisioning and administering firms.\n\n**Signing in.** Every route but \u0060/health\u0060 takes an Insolvia staff member\u0027s Google Workspace ID token as \u0060Authorization: Bearer \u003Ctoken\u003E\u0060.\n\n**Errors.** Every refusal is a JSON \u0060ErrorBody\u0060: \u0060error\u0060 is a stable code to branch on, \u0060message\u0060 is for people, and a validation error names the \u0060fields\u0060 at fault.\n\n**Absent, not null.** A member a schema does not require is left out when it is unset, never sent as \u0060null\u0060.\n\n**Times** are ISO 8601 in UTC; court dates are \u0060YYYY-MM-DD\u0060.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/v1/firms": {
      "post": {
        "tags": ["Firm"],
        "summary": "Provision a firm and invite its first administrator",
        "description": "The first user is an administrator with every permission, whatever the\nbody says: a firm whose first user cannot administer it is bricked at\nbirth. A 409 means a firm or user with that identity already exists.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": ["name", "admin"],
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The firm\u0027s name."
                  },
                  "admin": {
                    "required": ["email"],
                    "type": "object",
                    "properties": {
                      "email": {
                        "type": "string",
                        "description": "Where the invitation goes; also their sign-in."
                      },
                      "firstName": {
                        "type": ["null", "string"],
                        "description": "Their first name."
                      },
                      "lastName": {
                        "type": ["null", "string"],
                        "description": "Their last name."
                      },
                      "displayName": {
                        "type": ["null", "string"],
                        "description": "A whole name, split into first and last when those are absent."
                      },
                      "role": {
                        "enum": ["attorney", "paralegal", "staff", null]
                      }
                    },
                    "description": "A new firm\u0027s first administrator, who is sent a sign-in invitation."
                  }
                },
                "description": "A firm to provision (\u0060POST /v1/firms\u0060)."
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvisionedFirm"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "google": []
          }
        ]
      },
      "get": {
        "tags": ["Firm"],
        "summary": "Every firm, with its user count",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FirmList"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "google": []
          }
        ]
      }
    },
    "/v1/firms/{firmId}": {
      "get": {
        "tags": ["Firm"],
        "summary": "One firm, with its user count",
        "parameters": [
          {
            "name": "firmId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FirmSummaryView"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "google": []
          }
        ]
      },
      "patch": {
        "tags": ["Firm"],
        "summary": "Suspend or reactivate a firm",
        "description": "A suspended firm stays in place, but none of its users can reach the API\nuntil it is reactivated \u2014 immediately, since the API re-reads the firm on\nevery request. \u0060status\u0060 is the only field this route writes: the\nfirm\u0027s name belongs to its own admins.",
        "parameters": [
          {
            "name": "firmId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": ["status"],
                "type": "object",
                "properties": {
                  "status": {
                    "enum": ["active", "suspended"],
                    "description": "A firm\u0027s status. Only the admin service writes it (Firm FirmLifecycle.SetFirmStatus(Firm firm, FirmStatus status, TimeProvider? clock = null))."
                  }
                },
                "description": "A firm\u0027s new status (\u0060PATCH /v1/firms/{firmId}\u0060)."
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FirmView"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "google": []
          }
        ]
      }
    },
    "/v1/firms/{firmId}/users": {
      "get": {
        "tags": ["Firm"],
        "summary": "A firm\u0027s users",
        "parameters": [
          {
            "name": "firmId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FirmUserList"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "google": []
          }
        ]
      }
    },
    "/v1/firms/{firmId}/users/{subject}/resend-invite": {
      "post": {
        "tags": ["Firm"],
        "summary": "Send a user their sign-in invitation again, with a fresh temporary password",
        "description": "A 409 for a user who has already signed in: forgot-password is their way\nback in. A subject from another firm is the same 404 as an unknown one.",
        "parameters": [
          {
            "name": "firmId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subject",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "google": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Liveness, and which environment answered",
        "responses": {
          "200": {
            "description": "The body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthBody"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Address": {
        "type": "object",
        "properties": {
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "county": {
            "type": "string"
          },
          "raw": {
            "type": "string"
          }
        },
        "description": "Structured parts AND a raw fallback (the IEPD\u0027s free-text form, for a\ncreditor block that will not parse). string? Address.County is B101 line 5\u0027s box.\nstring? Address.PostalCode is \u0060postalCode\u0060 under every serializer, the\nstored rows\u0027 snake_case one included (ADR 0032)."
      },
      "ErrorBody": {
        "required": ["error"],
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "The code: \u0060ValidationError\u0060, \u0060NotFound\u0060, \u0060Forbidden\u0060, \u0060Conflict\u0060, \u2026."
          },
          "message": {
            "type": "string",
            "description": "What went wrong, for a person."
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "For a validation error: each field at fault, by name, and what is wrong with it."
          }
        },
        "description": "Every refusal\u0027s body: the error\u0027s code, and either a message or \u2014 for a\nvalidation error \u2014 the fields at fault, each with what is wrong with it."
      },
      "FirmList": {
        "required": ["firms"],
        "type": "object",
        "properties": {
          "firms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FirmSummaryView"
            },
            "description": "The firms, each with its user count."
          }
        },
        "description": "Every firm."
      },
      "FirmRole": {
        "enum": ["attorney", "paralegal", "staff"],
        "description": "A job title, and NOT a level of access: it drives the DEFAULT permission\nmap a new user gets and nothing else. What someone can reach is\n\u0060IsAdmin\u0060, \u0060AccessAllCases\u0060 and the permission map."
      },
      "FirmStatus": {
        "enum": ["active", "suspended"],
        "description": "A firm\u0027s status. Only the admin service writes it (Firm FirmLifecycle.SetFirmStatus(Firm firm, FirmStatus status, TimeProvider? clock = null))."
      },
      "FirmSummaryView": {
        "required": [
          "userCount",
          "id",
          "name",
          "status",
          "createdAt",
          "updatedAt",
          "createdBy",
          "createdByEmail",
          "defaultCourt",
          "defaultDivision",
          "defaultChapter",
          "letterhead"
        ],
        "type": "object",
        "properties": {
          "userCount": {
            "type": "integer",
            "description": "How many users it has, of every status.",
            "format": "int32"
          },
          "id": {
            "type": "string",
            "description": "The firm\u0027s id."
          },
          "name": {
            "type": "string",
            "description": "The firm\u0027s name."
          },
          "status": {
            "description": "Active, or suspended (none of its users can reach the API).",
            "$ref": "#/components/schemas/FirmStatus"
          },
          "createdAt": {
            "type": "string",
            "description": "When it was provisioned, ISO 8601 UTC to the millisecond."
          },
          "updatedAt": {
            "type": "string",
            "description": "When it last changed, ISO 8601 UTC to the millisecond."
          },
          "createdBy": {
            "type": ["null", "string"],
            "description": "The subject of the staff member who provisioned it; null when nobody recorded."
          },
          "createdByEmail": {
            "type": ["null", "string"],
            "description": "Their email; null when nobody recorded."
          },
          "defaultCourt": {
            "type": ["null", "string"],
            "description": "The court a new case starts in (its CM/ECF code); null when unset."
          },
          "defaultDivision": {
            "type": ["null", "string"],
            "description": "That court\u0027s division; null when unset."
          },
          "defaultChapter": {
            "type": ["null", "integer"],
            "description": "The chapter a new case starts as; null when unset.",
            "format": "int32"
          },
          "letterhead": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The firm\u0027s letterhead, its unanswered parts absent; null when it has none.",
                "$ref": "#/components/schemas/Letterhead"
              }
            ]
          }
        },
        "description": "A firm with how many users it has \u2014 the list and the single read."
      },
      "FirmUserList": {
        "required": ["users"],
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FirmUserView"
            },
            "description": "The users."
          }
        },
        "description": "A firm\u0027s users."
      },
      "FirmUserStatus": {
        "enum": ["active", "disabled"],
        "description": "A firm user\u0027s status. A disabled user has no permissions at all."
      },
      "FirmUserView": {
        "required": [
          "subject",
          "email",
          "firstName",
          "lastName",
          "displayName",
          "role",
          "isAdmin",
          "accessAllCases",
          "permissions",
          "status",
          "createdAt",
          "updatedAt",
          "signatureBlock"
        ],
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "description": "The user\u0027s sign-in subject."
          },
          "email": {
            "type": "string",
            "description": "Their email."
          },
          "firstName": {
            "type": "string",
            "description": "Their first name."
          },
          "lastName": {
            "type": "string",
            "description": "Their last name."
          },
          "displayName": {
            "type": "string",
            "description": "First and last name together."
          },
          "role": {
            "description": "Their role at the firm.",
            "$ref": "#/components/schemas/FirmRole"
          },
          "isAdmin": {
            "type": "boolean",
            "description": "Whether they administer the firm."
          },
          "accessAllCases": {
            "type": "boolean",
            "description": "Whether they see every case, not only their own."
          },
          "permissions": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/PermissionLevel"
            },
            "description": "The stored level for each feature."
          },
          "status": {
            "description": "Invited, active or deactivated.",
            "$ref": "#/components/schemas/FirmUserStatus"
          },
          "createdAt": {
            "type": "string",
            "description": "When they were added, ISO 8601 UTC to the millisecond."
          },
          "updatedAt": {
            "type": "string",
            "description": "When they last changed, ISO 8601 UTC to the millisecond."
          },
          "signatureBlock": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "What signs their filings, its unanswered parts absent; null when they have none.",
                "$ref": "#/components/schemas/SignatureBlock"
              }
            ]
          }
        },
        "description": "A firm\u0027s user, whole: this caller administers firms. \u0060permissions\u0060 is\nthe STORED map, not the effective one (an admin\u0027s is every feature)."
      },
      "FirmView": {
        "required": [
          "id",
          "name",
          "status",
          "createdAt",
          "updatedAt",
          "createdBy",
          "createdByEmail",
          "defaultCourt",
          "defaultDivision",
          "defaultChapter",
          "letterhead"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The firm\u0027s id."
          },
          "name": {
            "type": "string",
            "description": "The firm\u0027s name."
          },
          "status": {
            "description": "Active, or suspended (none of its users can reach the API).",
            "$ref": "#/components/schemas/FirmStatus"
          },
          "createdAt": {
            "type": "string",
            "description": "When it was provisioned, ISO 8601 UTC to the millisecond."
          },
          "updatedAt": {
            "type": "string",
            "description": "When it last changed, ISO 8601 UTC to the millisecond."
          },
          "createdBy": {
            "type": ["null", "string"],
            "description": "The subject of the staff member who provisioned it; null when nobody recorded."
          },
          "createdByEmail": {
            "type": ["null", "string"],
            "description": "Their email; null when nobody recorded."
          },
          "defaultCourt": {
            "type": ["null", "string"],
            "description": "The court a new case starts in (its CM/ECF code); null when unset."
          },
          "defaultDivision": {
            "type": ["null", "string"],
            "description": "That court\u0027s division; null when unset."
          },
          "defaultChapter": {
            "type": ["null", "integer"],
            "description": "The chapter a new case starts as; null when unset.",
            "format": "int32"
          },
          "letterhead": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The firm\u0027s letterhead, its unanswered parts absent; null when it has none.",
                "$ref": "#/components/schemas/Letterhead"
              }
            ]
          }
        },
        "description": "A firm as staff administer it: its defaults and its provisioning provenance,\neach written as \u0060null\u0060 when unset rather than left out \u2014\n\u0060createdBy: null\u0060 tells the portal \u0022nobody recorded\u0022 (a seeded firm).\nThe tenant API never answers with the provenance."
      },
      "HealthBody": {
        "required": ["environment", "status"],
        "type": "object",
        "properties": {
          "environment": {
            "type": "string",
            "description": "The configured environment."
          },
          "status": {
            "type": "string",
            "description": "Always \u0060ok\u0060."
          }
        },
        "description": "The \u0060/health\u0060 body."
      },
      "Letterhead": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "address": {
            "description": "The office address; an empty one when none was given.",
            "$ref": "#/components/schemas/Address"
          }
        },
        "description": "What the firm prints at the top of a letter and on the signer block\u0027s firm\nlines (issue #360). Every field optional."
      },
      "PermissionLevel": {
        "enum": ["hidden", "view_only", "add_edit"],
        "description": "What a permission can be set to, ordered weakest to strongest. THE ORDER IS\nLOAD-BEARING \u2014 bool Permissions.Permits(FirmUser user, Feature feature, PermissionLevel required) compares the numeric\nvalues, so inserting a level in the middle changes every existing check."
      },
      "ProvisionedFirm": {
        "required": ["firm", "admin"],
        "type": "object",
        "properties": {
          "firm": {
            "description": "The firm.",
            "$ref": "#/components/schemas/FirmView"
          },
          "admin": {
            "description": "Its first user, an administrator with every permission.",
            "$ref": "#/components/schemas/FirmUserView"
          }
        },
        "description": "A newly provisioned firm and its first administrator."
      },
      "SignatureBlock": {
        "type": "object",
        "properties": {
          "barNumber": {
            "type": "string"
          },
          "barState": {
            "type": "string"
          },
          "firmName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "address": {
            "description": "The address on the block; an empty one when none was given.",
            "$ref": "#/components/schemas/Address"
          }
        },
        "description": "An attorney\u0027s standing signature block (issue #360). The member names and\nlimits are a \u0060filingProfessional\u0060 body\u0027s, so \u0022use firm default\u0022 copies\nit with no mapping. The name is not here \u2014 it is the firm user\u0027s own."
      }
    },
    "responses": {
      "Error": {
        "description": "Refused: the error code, and a message or the fields at fault.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "google": {
        "type": "http",
        "description": "A staff member\u0027s Google Workspace ID token.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Firm"
    },
    {
      "name": "Health"
    }
  ]
}
