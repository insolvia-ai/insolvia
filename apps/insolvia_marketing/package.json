{
  "name": "@insolvia/marketing",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "//": [
    "The site owns its UI components (app/ui/), themed off @insolvia-ai/tokens'",
    "generated app/styles/theme.css. There is no separate design-system package",
    "any more — so `clsx` and `tailwind-merge` (used by app/lib/cn at render",
    "time, including SSR) are real `dependencies`, present in the Docker image",
    "after `npm ci --omit=dev`, not devDependencies."
  ],
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint app server",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-router/architect": "^7.18.1",
    "@react-router/node": "^7.18.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@react-router/dev": "^7.18.1",
    "@react-router/fs-routes": "^7.18.1",
    "@react-router/serve": "^7.18.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.19.0",
    "vite": "^8.1.3",
    "vitest": "^2.1.2"
  }
}
