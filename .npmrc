# @insolvia-ai is published to GitHub Packages, not npmjs.org. Everything else
# (react, expo, react-native, …) still resolves from the public registry.
#
# This file did not exist while @insolvia-ai/design-system and
# @insolvia-ai/tokens were workspace members here: npm linked them from source
# and never contacted a registry. They live in
# github.com/insolvia-ai/design-system now, so the root install has to fetch
# them like any other dependency — and apps/insolvia_marketing is no longer the
# only tree that needs this configuration. Its own .npmrc stays where it is;
# that tree installs from its own lockfile, deliberately outside this
# workspace.
@insolvia-ai:registry=https://npm.pkg.github.com

# npm expands ${NODE_AUTH_TOKEN} from the environment when it READS this file.
# The variable reference below is the literal, committed content — this repo is
# public (see CLAUDE.md), so a real token must never appear here. CI supplies
# the value via `NODE_AUTH_TOKEN: ${{ secrets.GITHUB_TOKEN }}`; a human runs
#   eval "$(./scripts/github-packages-auth.sh --export)"
# before `npm install`. GitHub Packages requires a token even for public
# packages, so an unset NODE_AUTH_TOKEN fails the install with a 401.
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
