<Project>
  <!--
    Central package management: every NuGet version in the backend is written
    here, once. A project file names a package with no Version attribute.
    Adding a package means adding its PackageVersion line here in the same PR.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Hosting">
    <!-- ASP.NET Core on Lambda behind an HTTP API (payload format 2.0). -->
    <PackageVersion Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup Label="MCP">
    <!-- The official C# MCP SDK (18.21; research 2026-10-27): the 2026-07-28
         stateless Streamable HTTP transport, version negotiation and the
         legacy initialize bridge. Insolvia.Mcp owns the shims it lacks (JSON
         responses, Host/Origin checks). Pinned exact with the Python side's
         mcp==2.1.1 in mind: one protocol stack per service. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup Label="Lambda (non-HTTP hosts)">
    <!-- A one-shot host (the migrator) runs its own handler under the Lambda
         runtime client. Same versions the API's hosting package resolves, so
         one image family never carries two copies. -->
    <PackageVersion Include="Amazon.Lambda.Core" Version="3.3.0" />
    <PackageVersion Include="Amazon.Lambda.RuntimeSupport" Version="2.2.0" />
    <PackageVersion Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
  </ItemGroup>
  <ItemGroup Label="Data">
    <!-- EF Core and its design-time half move together: a migration generated
         by one version and applied by another is how snapshots drift. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- IAM database authentication tokens (RDSAuthTokenGenerator), and the
         migrator's read of the RDS-managed master secret. -->
    <PackageVersion Include="AWSSDK.RDS" Version="4.0.107.2" />
    <PackageVersion Include="AWSSDK.SecretsManager" Version="4.0.100.22" />
  </ItemGroup>
  <ItemGroup Label="Sealed data">
    <!-- The tax-id cipher and the credential vault: GenerateDataKey / Decrypt.
         On the same AWSSDK.Core (4.0.102.14) as AWSSDK.RDS above. -->
    <PackageVersion Include="AWSSDK.KeyManagementService" Version="4.0.101" />
  </ItemGroup>
  <ItemGroup Label="Case documents">
    <!-- The document bucket: presigned SigV4 PUT/GET, HeadObject, tag clearing
         (S3DocumentBlobStore). Needs AWSSDK.Core >= 4.0.102.10 — the 4.0.102.14 above satisfies it. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.3" />
  </ItemGroup>
  <ItemGroup Label="Job pipeline">
    <!-- The pipeline queue (ADR 0018): the API's enqueue (SqsJobSender) and
         the worker's local poller. On the same AWSSDK.Core as the rest. -->
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.17" />
    <!-- The worker's model calls (ADR 0019), pinned exact: the request bodies
         are pinned to the Python adapters' by WireParityTests, and a newer
         SDK may change the anthropic-version it sends (research
         dotnet-mcp-and-anthropic-sdks-2026-10-27 § 3.3). Worker image only. -->
    <PackageVersion Include="Anthropic" Version="[13.3.0]" />
  </ItemGroup>
  <ItemGroup Label="AWS adapters">
    <!-- The default credential chain the mailer client signs with (SigV4 to
         the mailer's IAM-authorised API). The same version AWSSDK.RDS already
         resolves transitively, so one image carries one copy. -->
    <PackageVersion Include="AWSSDK.Core" Version="4.0.102.14" />
    <!-- The firm pool's AdminCreateUser (invite and resend) and the seeder's
         account convergence. On AWSSDK.Core [4.0.102.10, 5), so the pin above holds. -->
    <PackageVersion Include="AWSSDK.CognitoIdentityProvider" Version="4.0.106.2" />
  </ItemGroup>
  <ItemGroup Label="Identity">
    <!-- Token verification in Insolvia.Core: the signature check IS the domain
         rule (auth.py's one PyJWT exception, carried over). Fetching a key is
         a port; Core never makes the HTTP call. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0" />
  </ItemGroup>
  <ItemGroup Label="PDF">
    <!-- The PDF object model under Insolvia.Forms (ADR 0028 § Libraries).
         6.2.4 is the LAST MIT release: PDFsharp 6.5.0 and later are
         AGPL-3.0-only or commercial (2026-10-14). Upgrading past it is a
         licensing decision, not a dependency bump — never float it. -->
    <PackageVersion Include="PDFsharp" Version="[6.2.4]" />
    <!-- PDFsharp 6.2.4 pulls System.Security.Cryptography.Pkcs 8.0.1, which
         carries a high-severity advisory (GHSA-846f-f764-76mx); a direct
         reference at a fixed version lifts it. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- The data tier tests against a real Postgres, never an in-memory provider. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
