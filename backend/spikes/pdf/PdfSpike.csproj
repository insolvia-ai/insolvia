<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike #514 (plan 18.3). Standalone on purpose: not part of any solution.
       docs/research/dotnet-pdf-engine-2026-10-27.md owns the findings. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 6.2.4 is the LAST MIT release. PDFsharp 6.5.0 and 7.0.0-preview-2
         (2026-10-14) are AGPL-3.0-only or commercial — do not float this. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp 6.2.4 pulls Pkcs 8.0.1, which carries a high-severity
         advisory (GHSA-846f-f764-76mx); a direct reference lifts it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
