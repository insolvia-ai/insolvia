    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="AWSSDK.RDS" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Insolvia.Domain/Insolvia.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Insolvia.Data.Tests" />
  </ItemGroup>
</Project>
