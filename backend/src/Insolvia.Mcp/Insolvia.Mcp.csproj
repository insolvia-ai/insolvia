<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Host: the MCP server (services/mcp's port, plan 18.21). ASP.NET Core,
       served by Kestrel under `dotnet run` and by the Lambda runtime behind
       an HTTP API in a deployed environment; Program.cs says how one binary
       does both. The protocol is the official C# MCP SDK; the tools, the
       auth seam and the transport shims are ours. -->
  <PropertyGroup>
    <!-- The Lambda base image runs an executable assembly by name: the
         Dockerfile's CMD is this name. -->
    <AssemblyName>Insolvia.Mcp</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Insolvia.Core/Insolvia.Core.csproj" />
    <ProjectReference Include="../Insolvia.Data/Insolvia.Data.csproj" />
    <ProjectReference Include="../Insolvia.Aws/Insolvia.Aws.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Insolvia.Mcp.Tests" />
  </ItemGroup>
</Project>
