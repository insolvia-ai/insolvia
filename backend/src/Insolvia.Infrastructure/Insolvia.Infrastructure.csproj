<Project Sdk="Microsoft.NET.Sdk">
  <!-- The adapters behind Core's ports (ADR 0030), referenced by hosts only.
       Namespaces follow the folders, not this assembly's name:
       - Data/ (Insolvia.Data.*): EF Core, the migrations and the Postgres
         stores; AWSSDK.RDS mints the IAM database tokens;
       - Aws/ (Insolvia.Aws.*): the KMS envelope, S3, SQS, the Cognito
         directory and the mailer client. -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="AWSSDK.Core" />
    <PackageReference Include="AWSSDK.RDS" />
    <PackageReference Include="AWSSDK.KeyManagementService" />
    <PackageReference Include="AWSSDK.CognitoIdentityProvider" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="AWSSDK.SQS" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Insolvia.Core/Insolvia.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The byte-identity test against Python seals with a fixed nonce, which
         is internal on purpose: a caller-chosen nonce is a GCM footgun. -->
    <InternalsVisibleTo Include="Insolvia.Infrastructure.Tests" />
  </ItemGroup>
</Project>
