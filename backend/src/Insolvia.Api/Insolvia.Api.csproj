<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Host: the API lambdalith. ASP.NET Core minimal APIs, served by Kestrel
       under `dotnet run` and by the Lambda runtime behind an HTTP API in a
       deployed environment; Program.cs says how one binary does both. -->
  <PropertyGroup>
    <!-- The Lambda base image runs an executable assembly by name: the
         Dockerfile's CMD is this name. -->
    <AssemblyName>Insolvia.Api</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" />
    <!-- Referenced here, not only through Http: its source generator reads
         this project's doc comments into the OpenAPI document's summaries. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <!-- The wire every HTTP host shares (WireJson, ErrorBody, WireOpenApi, …). -->
    <Using Include="Insolvia.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Insolvia.Domain/Insolvia.Domain.csproj" />
    <ProjectReference Include="../Insolvia.Data/Insolvia.Data.csproj" />
    <ProjectReference Include="../Insolvia.Platform/Insolvia.Platform.csproj" />
    <ProjectReference Include="../Insolvia.Http/Insolvia.Http.csproj" />
  </ItemGroup>
</Project>
