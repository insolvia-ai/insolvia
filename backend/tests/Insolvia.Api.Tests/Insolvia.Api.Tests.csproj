<Project Sdk="Microsoft.NET.Sdk">
  <!-- Route tests for Insolvia.Api, in-process through WebApplicationFactory:
       Kestrel and Lambda are not involved, the routing and serialization are. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <!-- The probe routes and the auth host are written against the same
         ASP.NET Core surface Insolvia.Api uses. -->
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <!-- core/mail.py's own output, which MailTemplateTests holds the port to. -->
    <None Include="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The analysis routes' end-to-end parity: the Python oracle's own case
         files and outputs, owned by the Engines tests (Parity/*.json). -->
    <None Include="../Insolvia.Engines.Tests/Parity/*.json" LinkBase="Parity" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Insolvia.Api/Insolvia.Api.csproj" />
    <!-- The pipeline end to end (PipelineEndToEndTests): the API accepts, the
         WORKER consumes the message it sent, the API serves the result. Under
         an extern alias: both hosts compile a top-level `Program`, and only
         the API's is the factory's. A test project may hold two hosts; a host
         never references another. -->
    <ProjectReference Include="../../src/Insolvia.Worker/Insolvia.Worker.csproj" Aliases="worker" />
  </ItemGroup>
  <ItemGroup>
    <!-- The reference case the end-to-end test assembles, read in place. -->
    <None Include="../Insolvia.Engines.Tests/Parity/reference-ch7.case.json" Link="CaseFiles/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Insolvia.Forms.Tests/Support/CaseFiles.cs" Link="Support/CaseFiles.cs" />
    <Compile Include="../Insolvia.Forms.Tests/Support/CaseDatas.cs" Link="Support/CaseDatas.cs" />
  </ItemGroup>
</Project>
